APP_NAME=Travel Agent Bot
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ROLLINGGO_MCP_URL=http://127.0.0.1:8010/mcp
ROLLINGGO_API_KEY=
ROLLINGGO_ACCEPT_LANGUAGE=en_US
ROLLINGGO_LOCAL_MCP_HOST=127.0.0.1
ROLLINGGO_LOCAL_MCP_PORT=8010
ROLLINGGO_API_BASE_URL=
ROLLINGGO_SEARCH_HOTELS_PATH=/searchHotels
ROLLINGGO_HOTEL_DETAIL_PATH=/getHotelDetail
ROLLINGGO_SEARCH_TAGS_PATH=/getHotelSearchTags

HOTEL_COUNTRY_CODE=EG
HOTEL_CURRENCY=EGP
HOTEL_DB_BUILD_CHECKIN=2026-08-01
HOTEL_DB_BUILD_NIGHTS=2
HOTEL_DB_BUILD_ADULTS=2
HOTEL_DB_BUILD_ROOM_COUNT=1
HOTEL_DB_TOP_N=20
HOTEL_DISPLAY_TOP_N=5

ENABLE_CLIP_IMAGE_EMBEDDINGS=true
CLIP_IMAGE_WEIGHT=0.20
CHROMA_DB_PATH=backend/chroma_db
HOTEL_COLLECTION_NAME=egypt_hotels

CHROMA_PERSIST_DIRECTORY=backend/chroma_db
CHROMA_COLLECTION_NAME=egypt_hotels
EMBEDDING_MODEL=all-MiniLM-L6-v2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLEANER_MODEL=phi3:mini
OLLAMA_REVIEWER_MODEL=phi3:mini
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org
API_BASE_URL=http://127.0.0.1:8000
